---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingView from '../../components/ListingView.tsx';

const allResources = await getCollection('resources');
const sorted = allResources.sort((a, b) => a.data.name.localeCompare(b.data.name));

const tableData = sorted.map(r => ({
  href: r.data.website,
  external: true,
  name: r.data.name,
  type: r.data.type,
  provider: r.data.provider || '',
  openSource: r.data.openSource ? 'Yes' : 'No',
}));

const tableColumns = [
  { key: 'name', label: 'Resource', isLink: true, sortable: true },
  { key: 'type', label: 'Type', filterable: true, sortable: true },
  { key: 'provider', label: 'Provider', sortable: true },
  { key: 'openSource', label: 'Open Source', filterable: true, sortable: true },
];

const cardItems = sorted.map(r => ({
  href: r.data.website,
  name: r.data.name,
  description: r.data.description,
  tags: r.data.tags,
  meta: [r.data.type, r.data.provider, r.data.maturity, r.data.lastUpdated ? `Updated ${r.data.lastUpdated}` : ''].filter(Boolean).join(' \u00b7 '),
  badge: r.data.openSource ? 'Open Source' : undefined,
  badgeColor: 'text-accent bg-accent-glow',
  external: true,
}));

const itemListLd = {
  "@context": "https://schema.org", "@type": "ItemList",
  "name": "Quantum Computing Resources",
  "numberOfItems": allResources.length,
  "itemListElement": sorted.map((r, i) => ({
    "@type": "ListItem", "position": i + 1,
    "item": { "@type": "LearningResource", "name": r.data.name, "url": r.data.website, "description": r.data.description },
  })),
};
---
<BaseLayout
  title="Quantum Computing Resources"
  description={`Browse ${allResources.length} quantum computing frameworks, courses, funding programs, and tools.`}
  jsonLd={itemListLd}
>
  <article>
    <h1 class="h-xl">Quantum Computing Resources</h1>
    <div class="summary" role="doc-abstract">
      <p class="mt-4 body-lg text-text-secondary">{allResources.length} frameworks, courses, funding programs, and tools for quantum computing.</p>
    </div>

    <ListingView
      client:load
      tableData={tableData}
      tableColumns={tableColumns}
      cardItems={cardItems}
      searchPlaceholder="Search resources..."
    />
  </article>
</BaseLayout>
