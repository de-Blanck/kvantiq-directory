---
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';

function loadJson(filename: string, fallback: unknown = {}) {
  const filePath = resolve('data/generated', filename);
  if (!existsSync(filePath)) return fallback;
  try {
    return JSON.parse(readFileSync(filePath, 'utf-8'));
  } catch {
    return fallback;
  }
}

const confidenceDistribution = loadJson('confidence-distribution.json', []) as Array<{ label: string; value: number }>;
const coverageMap = loadJson('coverage-map.json', []) as Array<{ country: string; count: number }>;

const totalEntries = Array.isArray(coverageMap)
  ? coverageMap.reduce((sum, entry) => sum + (entry.count ?? 0), 0)
  : 0;

const didYouKnow = [
  {
    front: `${totalEntries || '200+'} verified entries`,
    back: 'Every entry in this directory is individually researched and verified against a minimum of two independent sources before publication. No self-reported data. No unverified press releases.',
  },
  {
    front: 'Weekly AI audit',
    back: 'An AI agent scans primary sources — company websites, EU project databases, arXiv, and major tech press — every week to flag stale data and propose updates for human review.',
  },
  {
    front: 'Confidence scoring',
    back: 'Each entry carries a confidence score reflecting source quality: high (peer-reviewed or official), medium (reputable press), or low (single or indirect source). Low-confidence entries are flagged for re-verification.',
  },
  {
    front: 'AI + human review',
    back: 'Full transparency means every change is attributed — AI suggestions are logged, human decisions are recorded in git history. The complete audit trail is public and permanent.',
  },
  {
    front: '90-day activity rule',
    back: "Entries are evaluated on a rolling 90-day window. Companies or projects with no verifiable activity in the past quarter are flagged as potentially inactive and scheduled for review.",
  },
  {
    front: 'Open methodology',
    back: 'The curation protocol, source requirements, confidence rubric, and audit schedule are all documented and public. Anyone can read exactly how this directory is built and maintained.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Research',
    description: 'Primary sources are identified: official websites, EU project databases (Quantum Flagship, EuroHPC), peer-reviewed papers, and major tech press. No self-reported data is accepted at face value.',
  },
  {
    number: '02',
    title: 'Verify',
    description: 'Every entry requires a minimum of two independently verified sources. Citations follow APA/IEEE style with DOI links where available. Each source includes a dateAccessed field.',
  },
  {
    number: '03',
    title: 'Audit',
    description: 'An AI agent runs weekly scans to detect stale entries, new publications, and changed company status. Proposed changes are queued for human review with full reasoning.',
  },
  {
    number: '04',
    title: 'Review',
    description: 'A human editor reviews all AI-proposed changes, approves or rejects each one, and commits to the repository. The complete decision log is retained in git history.',
  },
];
---
<BaseLayout
  title="Transparency"
  description="How the Kvantiq Directory is built and maintained — data sources, verification standards, AI audit process, and confidence scoring methodology."
>
  <main data-pagefind-ignore class="mx-auto max-w-3xl">

    <!-- Hero — kvs.semantic.type.heading.xl -->
    <h1 class="h-xl">Transparency</h1>
    <p class="mt-4 body-lg text-text-secondary">
      Every entry in this directory is independently researched, verified against multiple sources,
      and audited on a regular schedule. Here is exactly how it works.
    </p>

    <!-- How It Works — flip cards -->
    <section class="mt-12">
      <h2 class="eyebrow-lg text-text-secondary">How It Works</h2>

      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {didYouKnow.map((item) => (
          <div class="flip-card">
            <div class="flip-card-inner">
              <!-- Front -->
              <div class="flip-card-front rounded-xl border border-border bg-surface p-5 flex flex-col justify-between overflow-hidden">
                <p class="eyebrow text-text-muted">Did you know?</p>
                <p class="h-md text-text-primary">
                  {item.front}
                </p>
                <p class="body-sm text-text-muted">Hover to learn more</p>
              </div>
              <!-- Back -->
              <div class="flip-card-back rounded-xl border border-accent/40 bg-elevated p-5 flex items-center overflow-hidden">
                <p class="body-sm text-text-primary">
                  {item.back}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Our Process — numbered steps -->
    <section class="mt-12">
      <h2 class="eyebrow-lg text-text-secondary">Our Process</h2>

      <div class="mt-5 space-y-0">
        {steps.map((step, i) => (
          <div
            class={`group grid grid-cols-[56px_1fr] gap-x-4 rounded-lg p-4 -mx-4 transition-colors duration-[120ms] hover:bg-surface${i < steps.length - 1 ? ' border-b border-border' : ''}`}
          >
            <div class="pt-0.5">
              <span class="data-lg text-accent opacity-60" style="font-size: 24px;">
                {step.number}
              </span>
            </div>
            <div>
              <p class="h-sm text-text-primary transition-colors duration-[120ms] group-hover:text-accent">
                {step.title}
              </p>
              <p class="mt-1 body-default text-text-secondary">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Explore -->
    <section class="mt-12 mb-8">
      <h2 class="eyebrow-lg text-text-secondary">Explore</h2>
      <p class="mt-3 body-default text-text-secondary max-w-2xl">
        The full integrity trail — directory health, data-quality metrics, and a dated record of every
        automated sweep, including source cross-checks and credible-source coverage. All public, all verifiable.
      </p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <a
          href="/transparency/audit/"
          class="group block rounded-xl border border-border p-6 transition-colors duration-[120ms] hover:bg-surface"
        >
          <p class="eyebrow text-accent">Audit log</p>
          <p class="mt-2 h-md text-text-primary">Audit Dashboard</p>
          <p class="mt-1 body-default text-text-secondary">
            Browse the full history of AI-proposed changes, human decisions, and verification events.
          </p>
          <p class="mt-3 eyebrow text-accent transition-colors duration-[120ms]">
            View audit log &rarr;
          </p>
        </a>

        <a
          href="/transparency/intelligence/"
          class="group block rounded-xl border border-border p-6 transition-colors duration-[120ms] hover:bg-surface"
        >
          <p class="eyebrow text-accent">Coverage</p>
          <p class="mt-2 h-md text-text-primary">Industry Intelligence</p>
          <p class="mt-1 body-default text-text-secondary">
            What the directory covers: entries tracked, coverage by collection, and the mix of
            company types and regions represented.
          </p>
          <p class="mt-3 eyebrow text-accent transition-colors duration-[120ms]">
            View intelligence &rarr;
          </p>
        </a>

        <a
          href="/transparency/sweeps/"
          class="group block rounded-xl border border-border p-6 transition-colors duration-[120ms] hover:bg-surface"
        >
          <p class="eyebrow text-accent">Run history</p>
          <p class="mt-2 h-md text-text-primary">Sweep Log</p>
          <p class="mt-1 body-default text-text-secondary">
            A dated record of every weekly AI sweep — runtime, what it found and didn&rsquo;t, source cross-checks for inconsistencies, the 3-credible-source bar, and methodology adherence.
          </p>
          <p class="mt-3 eyebrow text-accent transition-colors duration-[120ms]">
            View sweep log &rarr;
          </p>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .flip-card {
    perspective: 1000px;
    height: 280px;
  }
  @media (min-width: 768px) {
    .flip-card {
      height: 300px;
    }
  }
  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.5s;
    transform-style: preserve-3d;
  }
  .flip-card:hover .flip-card-inner {
    transform: rotateY(180deg);
  }
  .flip-card-front,
  .flip-card-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }
  .flip-card-back {
    transform: rotateY(180deg);
  }
</style>
