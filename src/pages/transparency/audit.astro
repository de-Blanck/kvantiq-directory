---
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';

// --- Types ---
interface ConfidenceEntry {
  label: string;
  value: number;
}

interface CoverageEntry {
  country: string;
  count: number;
}

interface AuditActionEntry {
  action_taken: string;
  count: number;
}

interface SourceEffectivenessEntry {
  source_name: string;
  total_found: number;
  total_new: number;
}

interface TimelineEntry {
  date: string;
  collection: string;
  count: number;
}

// --- Data loader ---
function loadJson<T>(filename: string, fallback: T): T {
  const filePath = resolve('data/generated', filename);
  if (!existsSync(filePath)) return fallback;
  try {
    return JSON.parse(readFileSync(filePath, 'utf-8')) as T;
  } catch {
    return fallback;
  }
}

const confidenceDist = loadJson<ConfidenceEntry[]>('confidence-distribution.json', []);
const coverageMap    = loadJson<CoverageEntry[]>('coverage-map.json', []);
const auditSummary   = loadJson<AuditActionEntry[]>('audit-summary.json', []);
const sourceEff      = loadJson<SourceEffectivenessEntry[]>('source-effectiveness.json', []);
const entryTimeline  = loadJson<TimelineEntry[]>('entry-timeline.json', []);

// Aggregate timeline by date for the chart
const timelineDates = [...new Set(entryTimeline.map((e) => e.date))].sort();
const timelineCounts = timelineDates.map((d) =>
  entryTimeline.filter((e) => e.date === d).reduce((sum, e) => sum + e.count, 0)
);
// Cumulative total
const cumulativeCounts = timelineCounts.reduce<number[]>((acc, v) => {
  acc.push((acc.length > 0 ? acc[acc.length - 1] : 0) + v);
  return acc;
}, []);
const hasTimeline = timelineDates.length > 0;
const timelineData = { labels: timelineDates, values: cumulativeCounts };

// --- Derived values for chart ---
// Editorial Light tokens — Chart.js needs raw hex because it can't read CSS vars.
// Semantic gradient: HIGH = info blue (affirmative), MEDIUM = muted (neutral / unknown),
// LOW = warn amber, DEAD = error red. Avoids the accent/warn collision in Editorial Light.
const confidenceColors: Record<string, string> = {
  HIGH:   '#1D4ED8', // --color-info
  MEDIUM: '#78716C', // --color-text-muted
  LOW:    '#B45309', // --color-warn
  DEAD:   '#DC2626', // --color-error
};

const confidenceData = {
  labels: confidenceDist.map((d) => d.label),
  values: confidenceDist.map((d) => d.value),
  colors: confidenceDist.map((d) => confidenceColors[d.label] ?? '#78716C'), // text-muted fallback
};

const maxCoverageCount = Math.max(...coverageMap.map((c) => c.count), 1);

const totalAuditActions = auditSummary.reduce((sum, a) => sum + a.count, 0);
---

<BaseLayout
  title="Audit Dashboard"
  description="Directory health metrics: confidence distribution, geographic coverage, audit actions, and source effectiveness for the Kvantiq quantum computing directory."
>
  <main data-pagefind-ignore class="mx-auto max-w-5xl">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="h-xl text-text-primary">
        Audit Dashboard
      </h1>
      <p class="mt-4 body-lg text-text-secondary">
        Directory health metrics — confidence levels, geographic coverage, recent audit actions, and source effectiveness.
      </p>
    </div>

    <!-- 2-column grid: Confidence Chart + Coverage -->
    <div class="grid gap-6 sm:grid-cols-2 mb-8">

      <!-- Confidence Distribution (Chart.js doughnut) -->
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-4">
          Confidence Distribution
        </h2>
        {confidenceDist.length > 0 ? (
          <div class="flex flex-col items-center gap-4">
            <div class="relative w-48 h-48">
              <canvas id="confidence-chart" width="192" height="192"></canvas>
            </div>
            <!-- Legend -->
            <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1.5">
              {confidenceDist.map((d) => (
                <li class="flex items-center gap-1.5 body-sm text-text-secondary">
                  <span
                    class="inline-block w-2.5 h-2.5 rounded-full shrink-0"
                    style={`background-color: ${confidenceColors[d.label] ?? '#78716C'}`}
                  ></span>
                  <span class="capitalize">{d.label.toLowerCase()}</span>
                  <span class="data-md text-text-primary">{d.value}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="body-sm text-text-muted italic">No confidence data available.</p>
        )}
      </div>

      <!-- Coverage by Country -->
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-4">
          Coverage by Country
        </h2>
        {coverageMap.length > 0 ? (
          <ul class="space-y-2">
            {coverageMap.map((c) => (
              <li class="group">
                <div class="flex items-center justify-between mb-0.5">
                  <span class="body-sm text-text-secondary">
                    {c.country}
                  </span>
                  <span class="data-md text-text-primary">{c.count}</span>
                </div>
                <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                  <div
                    class="h-full rounded-full bg-accent transition-all duration-300"
                    style={`width: ${Math.round((c.count / maxCoverageCount) * 100)}%`}
                  ></div>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="body-sm text-text-muted italic">No coverage data available.</p>
        )}
      </div>
    </div>

    <!-- Entry Count Over Time -->
    {hasTimeline && (
      <section class="mb-8">
        <h2 class="eyebrow text-text-muted mb-4">
          Directory Growth
        </h2>
        <div class="rounded-xl border border-border bg-surface p-6">
          <canvas id="timeline-chart" height="200" aria-label="Directory entry count over time" role="img"></canvas>
        </div>
      </section>
    )}

    <!-- Recent Audit Actions -->
    <section class="mb-8">
      <h2 class="eyebrow text-text-muted mb-4">
        Recent Audit Actions
      </h2>
      {auditSummary.length > 0 ? (
        <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 md:grid-cols-4">
          {auditSummary.map((a) => (
            <div class="rounded-lg border border-border bg-surface p-4 text-center">
              <p class="data-lg text-text-primary">{a.count}</p>
              <p class="mt-1 body-sm capitalize text-text-secondary">
                {a.action_taken.replace(/_/g, ' ')}
              </p>
            </div>
          ))}
          {totalAuditActions > 0 && (
            <div class="rounded-lg border border-border bg-elevated p-4 text-center">
              <p class="data-lg text-text-primary">{totalAuditActions}</p>
              <p class="mt-1 eyebrow text-text-muted">Total actions</p>
            </div>
          )}
        </div>
      ) : (
        <p class="body-sm text-text-muted italic">No audit actions recorded yet.</p>
      )}
    </section>

    <!-- Source Effectiveness -->
    <section class="mb-8">
      <h2 class="eyebrow text-text-muted mb-4">
        Source Effectiveness
      </h2>
      {sourceEff.length > 0 ? (
        <div class="overflow-x-auto rounded-xl border border-border">
          <table class="w-full">
            <thead>
              <tr class="border-b border-border bg-elevated">
                <th class="px-4 py-3 text-left eyebrow text-text-muted">
                  Source
                </th>
                <th class="px-4 py-3 text-right eyebrow text-text-muted">
                  Total Found
                </th>
                <th class="px-4 py-3 text-right eyebrow text-text-muted">
                  Total New
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border bg-surface">
              {sourceEff.map((s) => (
                <tr>
                  <td class="px-4 py-3 body-sm font-medium text-text-primary">{s.source_name}</td>
                  <td class="px-4 py-3 text-right data-md text-text-secondary">{s.total_found}</td>
                  <td class="px-4 py-3 text-right data-md text-text-secondary">{s.total_new}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="body-sm text-text-muted italic">No source effectiveness data available.</p>
      )}
    </section>

  </main>
</BaseLayout>

<script define:vars={{ confidenceData, timelineData, hasTimeline }}>
  if (confidenceData.values.length > 0 || hasTimeline) {
    import('https://cdn.jsdelivr.net/npm/chart.js@4/+esm').then(({ ArcElement, Tooltip, Legend, DoughnutController, LineElement, PointElement, CategoryScale, LinearScale, LineController, Filler, Chart }) => {
      Chart.register(ArcElement, Tooltip, Legend, DoughnutController, LineElement, PointElement, CategoryScale, LinearScale, LineController, Filler);

      // Confidence doughnut
      const canvas = document.getElementById('confidence-chart');
      if (canvas && confidenceData.values.length > 0) {
        new Chart(canvas, {
          type: 'doughnut',
          data: {
            labels: confidenceData.labels,
            datasets: [
              {
                data: confidenceData.values,
                backgroundColor: confidenceData.colors,
                borderWidth: 0,
                hoverOffset: 4,
              },
            ],
          },
          options: {
            responsive: false,
            cutout: '68%',
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: { label: (ctx) => ` ${ctx.label}: ${ctx.parsed}` },
                bodyColor: '#1C1917',       // text-primary
                titleColor: '#57534E',      // text-secondary
                backgroundColor: '#FFFFFF', // base (lifts off warm parchment page)
                borderColor: '#DDD8CF',     // border
                borderWidth: 1,
              },
            },
          },
        });
      }

      // Entry timeline line chart — accent amber on warm parchment grid
      if (hasTimeline) {
        const timelineCanvas = document.getElementById('timeline-chart');
        if (timelineCanvas) {
          new Chart(timelineCanvas, {
            type: 'line',
            data: {
              labels: timelineData.labels,
              datasets: [{
                label: 'Total entries',
                data: timelineData.values,
                borderColor: '#B45309',                     // accent (warm amber/rust)
                backgroundColor: 'rgba(180, 83, 9, 0.10)',  // accent fill, subtle
                fill: true,
                tension: 0.3,
                pointRadius: 3,
                pointBackgroundColor: '#B45309',
              }],
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              plugins: { legend: { display: false }, tooltip: { enabled: true } },
              scales: {
                y: { ticks: { color: '#78716C' }, grid: { color: '#DDD8CF' }, border: { display: false } },
                x: { ticks: { color: '#78716C', maxRotation: 45 }, grid: { display: false }, border: { display: false } },
              },
            },
          });
        }
      }
    });
  }
</script>
</content>
</invoke>