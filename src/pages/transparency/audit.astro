---
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { credibleSourceCount, isCredibleSource, MIN_CREDIBLE_SOURCES } from '../../lib/source-bar';
import {
  growthSeries, coverageByCountry, entriesMissingFromLedger,
  sourceStrength, ageDistribution, newestDate, sourceConcentration,
} from '../../lib/audit-metrics';
import { rateEntry, ratingCounts } from '../../lib/content-quality';

// Every panel on this page is derived here, from the entries themselves and from
// data/entry-first-seen.json. Nothing is read out of a generated database dump:
// the three panels that were (confidence distribution, recent audit actions,
// source effectiveness) rendered a constant written once at migration time, or
// nothing at all, and were removed rather than restyled.

const COLLECTIONS = ['companies', 'benchmarks', 'use-cases', 'challenges', 'resources'] as const;

const DETAIL_ROUTE: Record<string, string | null> = {
  companies: 'companies', benchmarks: 'benchmarks', 'use-cases': 'use-cases',
  challenges: 'challenges', resources: null,
};

const entries = (
  await Promise.all(
    COLLECTIONS.map(async (collection) =>
      (await getCollection(collection as 'companies')).map((e) => ({
        collection,
        slug: e.data.slug,
        name: e.data.name,
        country: (e.data as { country?: string | null }).country ?? null,
        href: DETAIL_ROUTE[collection] ? `/${DETAIL_ROUTE[collection]}/${e.data.slug}/` : null,
        credible: credibleSourceCount(e.data.sources),
        total: (e.data.sources || []).length,
        sources: e.data.sources ?? [],
        lastAccessed: newestDate((e.data.sources ?? []).map((s: { dateAccessed?: string }) => s.dateAccessed)),
        lastNews: newestDate(((e.data as { news?: { date?: string }[] }).news ?? []).map((n) => n.date)),
        rating: rateEntry(collection, e.data as unknown as Record<string, unknown>).rating,
      })),
    ),
  )
).flat();

// --- Entries held back by the source bar ---
// Below MIN_CREDIBLE_SOURCES they are excluded from listings, sitemap and search,
// and served noindex. Listed publicly here rather than hidden, so the gate is visible.
const unlisted = entries
  .filter((e) => e.credible < MIN_CREDIBLE_SOURCES)
  .sort((a, b) => a.collection.localeCompare(b.collection) || a.name.localeCompare(b.name));

// --- First-seen ledger: the only honest basis for a growth chart ---
// Git history holds the real dates, but the deploy upload excludes .git, so they
// are resolved once and committed. See scripts/sync-entry-first-seen.ts.
function loadLedger(): Record<string, string> {
  const path = resolve('data/entry-first-seen.json');
  if (!existsSync(path)) return {};
  try {
    return JSON.parse(readFileSync(path, 'utf-8')) as Record<string, string>;
  } catch {
    return {};
  }
}

const firstSeen = loadLedger();
const growth = growthSeries(firstSeen, entries);
const unplaceable = entriesMissingFromLedger(firstSeen, entries);
const hasGrowth = growth.length > 1;

const coverage = coverageByCountry(entries);
const maxCoverageCount = Math.max(...coverage.map((c) => c.count), 1);

const TODAY = new Date().toISOString().slice(0, 10);

const strength = sourceStrength(entries.map((e) => e.credible), MIN_CREDIBLE_SOURCES);
const freshness = ageDistribution(entries.map((e) => e.lastAccessed), TODAY, 'No access date recorded');
const newsRecency = ageDistribution(entries.map((e) => e.lastNews), TODAY, 'No news recorded');
const concentration = sourceConcentration(entries, isCredibleSource, 12);
const quality = ratingCounts(entries.map((e) => ({ collection: e.collection, slug: e.slug, rating: e.rating, issues: [] })));

// Editorial Light tokens. Chart.js needed raw hex; these are Tailwind classes, but
// the mapping is written once here so a bucket's colour cannot drift between panels.
const BUCKET_TONE: Record<string, string> = {
  belowBar: 'bg-error', atBar: 'bg-warn', wellSourced: 'bg-text-muted', stronglySourced: 'bg-info',
  under30: 'bg-info', d30to90: 'bg-text-muted', d90to180: 'bg-warn', over180: 'bg-error', none: 'bg-border',
};

const pct = (n: number) => (entries.length > 0 ? Math.round((n / entries.length) * 100) : 0);

const timelineData = {
  labels: growth.map((p) => p.date),
  values: growth.map((p) => p.total),
};
---

<BaseLayout
  title="Audit Dashboard"
  description="Directory health for the Kvantiq quantum computing directory: how many independent credible sources each entry rests on, when it was last verified, and how the directory has grown."
>
  <main data-pagefind-ignore class="mx-auto max-w-5xl">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="h-xl text-text-primary">
        Audit Dashboard
      </h1>
      <p class="mt-4 body-lg text-text-secondary">
        Directory health, measured — what each entry rests on, when it was last verified, where the
        evidence comes from, and how the directory has grown. Every figure here is computed from the
        {entries.length} entries themselves; none of it is asserted, and there is no confidence grade
        to interpret.
      </p>
    </div>

    <!-- Source bar -->
    <section class="mb-8 rounded-xl border border-warn/40 bg-surface p-5">
      <h2 class="eyebrow text-warn mb-4">
        Held back by the source bar — {unlisted.length}
      </h2>
      <p class="body-sm text-text-secondary mb-4">
        Every entry needs at least {MIN_CREDIBLE_SOURCES} independent credible sources before it is
        published. These fall short, so they are excluded from the directory listings, the sitemap
        and search, and are served <code class="font-mono text-[12px]">noindex</code>. Their pages
        stay reachable so nothing already linked breaks. They return to the directory when the
        missing sources are found — not by lowering the bar.
      </p>
      {unlisted.length === 0 ? (
        <p class="body-sm text-text-secondary">Nothing is currently below the bar.</p>
      ) : (
        <ul class="grid gap-2 sm:grid-cols-2">
          {unlisted.map((e) => (
            <li class="flex items-baseline justify-between gap-3 border-b border-border py-1.5">
              <span class="text-[15px] text-text-primary">
                {e.href ? <a class="text-info underline" href={e.href}>{e.name}</a> : e.name}
                <span class="ml-2 font-mono text-[10px] uppercase tracking-[0.08em] text-text-muted">{e.collection}</span>
              </span>
              <span class="whitespace-nowrap font-mono text-[11px] text-warn">{e.credible}/{MIN_CREDIBLE_SOURCES} credible</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <!-- What each entry rests on -->
    <div class="grid gap-6 sm:grid-cols-2 mb-8">

      <!-- Source strength -->
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-1">Source strength</h2>
        <p class="body-sm text-text-muted mb-4">
          Independent credible sources per entry. The bar is {MIN_CREDIBLE_SOURCES}.
        </p>
        <ul class="space-y-2">
          {strength.map((b) => (
            <li>
              <div class="flex items-center justify-between mb-0.5">
                <span class="body-sm text-text-secondary">{b.label}</span>
                <span class="data-md text-text-primary">{b.count}</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                <div class={`h-full rounded-full ${BUCKET_TONE[b.key]}`} style={`width: ${pct(b.count)}%`}></div>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-4 body-sm text-text-secondary">
          {strength[1].count} entries ({pct(strength[1].count)}%) sit exactly at the minimum — they are
          published, but a single retracted source would unpublish them.
        </p>
      </div>

      <!-- Verification freshness -->
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-1">Verification freshness</h2>
        <p class="body-sm text-text-muted mb-4">
          Since each entry's most recently accessed source. Every source records the date it was read.
        </p>
        <ul class="space-y-2">
          {freshness.map((b) => (
            <li>
              <div class="flex items-center justify-between mb-0.5">
                <span class="body-sm text-text-secondary">{b.label}</span>
                <span class="data-md text-text-primary">{b.count}</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                <div class={`h-full rounded-full ${BUCKET_TONE[b.key]}`} style={`width: ${pct(b.count)}%`}></div>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-4 body-sm text-text-secondary">
          This is what the directory has instead of a confidence score: not a grade, but the date the
          evidence was last looked at.
        </p>
      </div>

    </div>

    <!-- News recency + completeness -->
    <div class="grid gap-6 sm:grid-cols-2 mb-8">

      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-1">News recency</h2>
        <p class="body-sm text-text-muted mb-4">
          Since each entry's most recent news item. Quiet is not the same as unverified.
        </p>
        <ul class="space-y-2">
          {newsRecency.map((b) => (
            <li>
              <div class="flex items-center justify-between mb-0.5">
                <span class="body-sm text-text-secondary">{b.label}</span>
                <span class="data-md text-text-primary">{b.count}</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                <div class={`h-full rounded-full ${BUCKET_TONE[b.key]}`} style={`width: ${pct(b.count)}%`}></div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-1">Completeness</h2>
        <p class="body-sm text-text-muted mb-4">
          Rated per collection against the fields that collection needs — the same rules
          <code class="font-mono text-[12px]">npm run audit:content</code> applies.
        </p>
        <table class="w-full">
          <thead>
            <tr class="border-b border-border">
              <th class="py-2 text-left eyebrow text-text-muted">Collection</th>
              <th class="py-2 text-right eyebrow text-text-muted">Rich</th>
              <th class="py-2 text-right eyebrow text-text-muted">Adequate</th>
              <th class="py-2 text-right eyebrow text-text-muted">Sparse</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {quality.map((row) => (
              <tr>
                <td class="py-2 body-sm text-text-secondary">{row.collection}</td>
                <td class="py-2 text-right data-md text-text-primary">{row.RICH}</td>
                <td class="py-2 text-right data-md text-text-secondary">{row.ADEQUATE}</td>
                <td class={`py-2 text-right data-md ${row.SPARSE > 0 ? 'text-warn' : 'text-text-muted'}`}>{row.SPARSE}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>

    <!-- Source concentration -->
    <section class="mb-8">
      <h2 class="eyebrow text-text-muted mb-1">Where the evidence comes from</h2>
      <p class="body-sm text-text-muted mb-4">
        {concentration.totalUrls} source URLs across {concentration.distinctDomains} domains. Counted by
        entries citing a domain, not by links — a directory leaning heavily on one outlet is less
        independently sourced than its source counts suggest.
      </p>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full">
          <thead>
            <tr class="border-b border-border bg-elevated">
              <th class="px-4 py-3 text-left eyebrow text-text-muted">Domain</th>
              <th class="px-4 py-3 text-right eyebrow text-text-muted">Entries citing</th>
              <th class="px-4 py-3 text-right eyebrow text-text-muted">Share of directory</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border bg-surface">
            {concentration.rows.map((row) => (
              <tr>
                <td class="px-4 py-3 body-sm text-text-primary">
                  {row.domain}
                  {!row.credible && (
                    <span class="ml-2 font-mono text-[10px] uppercase tracking-[0.08em] text-warn">
                      not credible
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-right data-md text-text-secondary">{row.entries}</td>
                <td class="px-4 py-3 text-right data-md text-text-muted">{pct(row.entries)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 body-sm text-text-muted">
        Domains marked <span class="text-warn">not credible</span> are cited but do not count toward the
        {' '}{MIN_CREDIBLE_SOURCES}-source bar — self-published or syndicated, per the sweep's blocklist.
      </p>
    </section>

    <!-- Coverage by country -->
    <section class="mb-8">
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-4">
          Coverage by Country
        </h2>
        {coverage.length > 0 ? (
          <ul class="space-y-2">
            {coverage.map((c) => (
              <li class="group">
                <div class="flex items-center justify-between mb-0.5">
                  <span class="body-sm text-text-secondary">
                    {c.country}
                  </span>
                  <span class="data-md text-text-primary">{c.count}</span>
                </div>
                <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                  <div
                    class="h-full rounded-full bg-accent transition-all duration-300"
                    style={`width: ${Math.round((c.count / maxCoverageCount) * 100)}%`}
                  ></div>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="body-sm text-text-muted italic">No coverage data available.</p>
        )}
      </div>
    </section>

    <!-- Entry count over time -->
    {hasGrowth && (
      <section class="mb-8">
        <h2 class="eyebrow text-text-muted mb-4">
          Directory Growth
        </h2>
        <div class="rounded-xl border border-border bg-surface p-6">
          <canvas id="timeline-chart" height="200" aria-label="Directory entry count over time" role="img"></canvas>
        </div>
        <p class="mt-3 body-sm text-text-muted">
          {growth.at(-1)?.total} entries, dated by the commit that introduced each one.
          {unplaceable.length > 0 && ` ${unplaceable.length} newer entr${unplaceable.length === 1 ? 'y is' : 'ies are'} not yet dated and are omitted.`}
        </p>
      </section>
    )}

  </main>
</BaseLayout>

<script define:vars={{ timelineData, hasGrowth }}>
  // Entry timeline — accent amber on the warm parchment grid. Chart.js needs raw
  // hex because it cannot read the CSS custom properties the rest of the page uses.
  if (hasGrowth) {
    import('https://cdn.jsdelivr.net/npm/chart.js@4/+esm').then(({ Tooltip, LineElement, PointElement, CategoryScale, LinearScale, LineController, Filler, Chart }) => {
      Chart.register(Tooltip, LineElement, PointElement, CategoryScale, LinearScale, LineController, Filler);

      const canvas = document.getElementById('timeline-chart');
      if (!canvas) return;

      new Chart(canvas, {
        type: 'line',
        data: {
          labels: timelineData.labels,
          datasets: [{
            label: 'Total entries',
            data: timelineData.values,
            borderColor: '#B45309',                     // accent (warm amber/rust)
            backgroundColor: 'rgba(180, 83, 9, 0.10)',  // accent fill, subtle
            fill: true,
            tension: 0.3,
            pointRadius: 3,
            pointBackgroundColor: '#B45309',
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: { legend: { display: false }, tooltip: { enabled: true } },
          scales: {
            y: { ticks: { color: '#78716C' }, grid: { color: '#DDD8CF' }, border: { display: false } },
            x: { ticks: { color: '#78716C', maxRotation: 45 }, grid: { display: false }, border: { display: false } },
          },
        },
      });
    });
  }
</script>
