---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { publishedOnly, MIN_CREDIBLE_SOURCES } from '../../lib/source-bar';

// Everything on this page is derived from the content collections at build time.
// It deliberately reads nothing from data/generated/: the three files this page
// used to depend on (market-snapshot, funding-timeline, events) are written by no
// script and were empty in production from the day the page shipped.

const companiesAll  = await getCollection('companies');
const benchmarksAll = await getCollection('benchmarks');
const useCasesAll   = await getCollection('use-cases');
const challengesAll = await getCollection('challenges');
const resourcesAll  = await getCollection('resources');

// Counts run through the source bar so this page never advertises an entry the
// site itself withholds.
const companies  = publishedOnly(companiesAll);
const benchmarks = publishedOnly(benchmarksAll);
const useCases   = publishedOnly(useCasesAll);
const challenges = publishedOnly(challengesAll);
const resources  = publishedOnly(resourcesAll);

const collectionRows = [
  { label: 'Companies',  href: '/companies/',  published: companies.length,  total: companiesAll.length },
  { label: 'Benchmarks', href: '/benchmarks/', published: benchmarks.length, total: benchmarksAll.length },
  { label: 'Use cases',  href: '/use-cases/',  published: useCases.length,   total: useCasesAll.length },
  { label: 'Challenges', href: '/challenges/', published: challenges.length, total: challengesAll.length },
  { label: 'Resources',  href: '/resources/',  published: resources.length,  total: resourcesAll.length },
].map((r) => ({ ...r, withheld: r.total - r.published }));

const totalPublished = collectionRows.reduce((n, r) => n + r.published, 0);
const totalTracked   = collectionRows.reduce((n, r) => n + r.total, 0);
const totalWithheld  = totalTracked - totalPublished;

const countryCount = new Set(companies.map((c) => c.data.country)).size;

function tally(values: string[]): { label: string; count: number }[] {
  const counts = new Map<string, number>();
  for (const v of values) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts.entries()]
    .map(([label, count]) => ({ label, count }))
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
}

const TYPE_LABELS: Record<string, string> = {
  hardware: 'Hardware', software: 'Software', cloud: 'Cloud',
  consulting: 'Consulting', research: 'Research', hybrid: 'Hybrid', other: 'Other',
};

const REGION_LABELS: Record<string, string> = {
  nordics: 'Nordics', dach: 'DACH', uk: 'UK',
  'western-europe': 'Western Europe', 'southern-europe': 'Southern Europe',
  'eastern-europe': 'Eastern Europe',
};

const byType   = tally(companies.map((c) => c.data.type));
const byRegion = tally(companies.map((c) => c.data.region));

const maxType   = Math.max(1, ...byType.map((d) => d.count));
const maxRegion = Math.max(1, ...byRegion.map((d) => d.count));
---
<BaseLayout
  title="Industry Intelligence"
  description="How the Kvantiq Directory covers the European quantum computing ecosystem: entries tracked, coverage by collection, and the shape of the companies listed."
>
  <main data-pagefind-ignore class="mx-auto max-w-5xl">

    <!-- Page header -->
    <div class="mb-8">
      <h1 class="h-xl text-text-primary">
        Industry Intelligence
      </h1>
      <p class="mt-4 body-lg text-text-secondary">
        The shape of what this directory covers — how many entries are tracked, where they
        sit, and what kinds of organisations they are. Every figure is derived from the
        published entries themselves, not from a separate dataset.
      </p>
    </div>

    <!-- At a glance -->
    <section class="mb-10">
      <h2 class="eyebrow text-text-muted mb-4">
        At a Glance
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="eyebrow text-text-muted">Entries Published</p>
          <p class="mt-2 data-lg text-text-primary">{totalPublished}</p>
          <p class="mt-1 body-sm text-text-secondary">across five collections</p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="eyebrow text-text-muted">Organisations</p>
          <p class="mt-2 data-lg text-text-primary">{companies.length}</p>
          <p class="mt-1 body-sm text-text-secondary">companies &amp; institutes</p>
        </div>

        <div class="rounded-xl border border-border bg-surface p-5">
          <p class="eyebrow text-text-muted">Countries</p>
          <p class="mt-2 data-lg text-text-primary">{countryCount}</p>
          <p class="mt-1 body-sm text-text-secondary">represented by a company</p>
        </div>

        <a
          href="/transparency/audit/"
          class="group block rounded-xl border border-border bg-surface p-5 transition-colors duration-[120ms] hover:bg-elevated"
        >
          <p class="eyebrow text-text-muted">Withheld</p>
          <p class="mt-2 data-lg text-text-primary">{totalWithheld}</p>
          <p class="mt-1 body-sm text-text-secondary">
            below the {MIN_CREDIBLE_SOURCES}-source bar &rarr;
          </p>
        </a>

      </div>
    </section>

    <!-- Coverage by collection -->
    <section class="mb-10">
      <h2 class="eyebrow text-text-muted mb-4">
        Coverage by Collection
      </h2>
      <div class="overflow-x-auto rounded-xl border border-border bg-surface">
        <table class="w-full text-left">
          <thead class="border-b border-border bg-elevated">
            <tr>
              <th class="px-5 py-3 eyebrow text-text-muted">Collection</th>
              <th class="px-5 py-3 eyebrow text-text-muted text-right">Published</th>
              <th class="px-5 py-3 eyebrow text-text-muted text-right">Withheld</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {collectionRows.map((row) => (
              <tr class="transition-colors duration-[120ms] hover:bg-elevated">
                <td class="px-5 py-3 body-sm">
                  <a href={row.href} class="text-text-primary hover:text-accent">{row.label}</a>
                </td>
                <td class="px-5 py-3 data-md text-text-primary text-right">{row.published}</td>
                <td class={`px-5 py-3 data-md text-right ${row.withheld > 0 ? 'text-warn' : 'text-text-muted'}`}>
                  {row.withheld > 0 ? row.withheld : '0'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Composition -->
    <div class="grid gap-6 sm:grid-cols-2 mb-10">

      <!-- By type -->
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-4">
          Companies by Type
        </h2>
        <ul class="space-y-2">
          {byType.map((d) => (
            <li class="group">
              <div class="flex items-center justify-between mb-0.5">
                <span class="body-sm text-text-secondary">{TYPE_LABELS[d.label] ?? d.label}</span>
                <span class="data-md text-text-primary">{d.count}</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                <div
                  class="h-full rounded-full bg-accent transition-all duration-300"
                  style={`width: ${Math.round((d.count / maxType) * 100)}%`}
                ></div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- By region -->
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-4">
          Companies by Region
        </h2>
        <ul class="space-y-2">
          {byRegion.map((d) => (
            <li class="group">
              <div class="flex items-center justify-between mb-0.5">
                <span class="body-sm text-text-secondary">{REGION_LABELS[d.label] ?? d.label}</span>
                <span class="data-md text-text-primary">{d.count}</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-border overflow-hidden">
                <div
                  class="h-full rounded-full bg-accent transition-all duration-300"
                  style={`width: ${Math.round((d.count / maxRegion) * 100)}%`}
                ></div>
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- What this page does not show -->
    <section class="mb-10">
      <div class="rounded-xl border border-border bg-surface p-5">
        <h2 class="eyebrow text-text-muted mb-3">
          What This Page Does Not Show
        </h2>
        <p class="body-sm text-text-secondary">
          No funding totals, funding timeline, or feed of ecosystem events. Reporting those
          honestly means tracking rounds and outcomes against independent sources for every
          organisation listed, and this directory does not do that yet. Until it does, the
          figures would be a floor of whatever happened to get written down rather than a
          measurement of the ecosystem — so they are absent rather than approximate.
        </p>
        <p class="mt-3 body-sm text-text-secondary">
          For how entries are verified, corrected and held back, see the
          <a href="/transparency/audit/" class="text-accent hover:underline">audit dashboard</a>
          and the <a href="/transparency/sweeps/" class="text-accent hover:underline">sweep log</a>.
        </p>
      </div>
    </section>

  </main>
</BaseLayout>
