---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListingView from '../../../components/ListingView.tsx';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  const countries = [...new Set(companies.map(c => c.data.country))];
  return countries.map(country => ({
    // Must match the href built in companies/[slug].astro, which hyphenates spaces.
    params: { country: country.toLowerCase().replace(/\s+/g, '-') },
    props: {
      countryName: country,
      companies: companies.filter(c => c.data.country === country),
    },
  }));
}

const { countryName, companies } = Astro.props;
const sorted = companies.sort((a: any, b: any) => a.data.name.localeCompare(b.data.name));

const tableData = sorted.map((c: any) => ({
  href: `/companies/${c.data.slug}/`,
  name: c.data.name,
  type: c.data.type,
  region: c.data.region,
  founded: c.data.founded ? String(c.data.founded) : '',
}));

const tableColumns = [
  { key: 'name', label: 'Company', isLink: true, sortable: true },
  { key: 'type', label: 'Type', filterable: true, sortable: true },
  { key: 'region', label: 'Region', filterable: true, sortable: true },
  { key: 'founded', label: 'Founded', sortable: true },
];

const cardItems = sorted.map((c: any) => ({
  href: `/companies/${c.data.slug}/`,
  name: c.data.name,
  description: c.data.description,
  tags: c.data.tags,
  meta: c.data.type,
  badge: c.data.featured ? 'Featured' : undefined,
  badgeColor: 'text-accent bg-accent-glow',
  // Group-by fields — mirror of tableData keys so CardGrid can group.
  type: c.data.type,
  region: c.data.region,
}));

const groupByOptions = [
  { key: 'type', label: 'Type' },
  { key: 'region', label: 'Region' },
];
---
<BaseLayout
  title={`Quantum Computing Companies in ${countryName}`}
  description={`Browse ${companies.length} quantum computing companies based in ${countryName}.`}
>
  <article>
    <h1 class="h-xl">Quantum Companies in {countryName}</h1>
    <div class="summary" role="doc-abstract">
      <p class="mt-4 body-lg text-text-secondary">
        {companies.length} quantum computing {companies.length === 1 ? 'company' : 'companies'} based in {countryName}.
      </p>
    </div>

    <div class="mt-4">
      <a href="/companies/" class="body-sm text-accent hover:underline">&larr; All companies</a>
    </div>

    <ListingView
      client:load
      tableData={tableData}
      tableColumns={tableColumns}
      cardItems={cardItems}
      searchPlaceholder={`Search companies in ${countryName}...`}
      groupByOptions={groupByOptions}
    />
  </article>
</BaseLayout>
