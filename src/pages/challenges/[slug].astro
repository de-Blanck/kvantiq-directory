---
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/source-bar';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailPage from '../../components/DetailPage.tsx';
import { findRelated, type RelatedItem } from '../../lib/related';
import { buildEventSchema } from '../../lib/jsonld/event.ts';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  const benchmarks = await getCollection('benchmarks');
  const useCases = await getCollection('use-cases');
  const challenges = await getCollection('challenges');
  const resources = await getCollection('resources');

  const allItems: RelatedItem[] = [
    ...companies.map(c => ({ slug: c.data.slug, name: c.data.name, description: c.data.description, collection: 'companies', tags: c.data.tags, href: `/companies/${c.data.slug}/` })),
    ...benchmarks.map(b => ({ slug: b.data.slug, name: b.data.name, description: b.data.description, collection: 'benchmarks', tags: b.data.tags, href: `/benchmarks/${b.data.slug}/` })),
    ...useCases.map(u => ({ slug: u.data.slug, name: u.data.name, description: u.data.description, collection: 'use-cases', tags: u.data.tags, href: `/use-cases/${u.data.slug}/` })),
    ...challenges.map(ch => ({ slug: ch.data.slug, name: ch.data.name, description: ch.data.description, collection: 'challenges', tags: ch.data.tags, href: `/challenges/${ch.data.slug}/` })),
    ...resources.map(r => ({ slug: r.data.slug, name: r.data.name, description: r.data.description, collection: 'resources', tags: r.data.tags, href: `/resources/` })),
  ];

  return challenges.map(ch => ({
    params: { slug: ch.data.slug },
    props: {
      challenge: ch.data,
      related: findRelated(ch.data.slug, ch.data.tags, allItems),
    },
  }));
}

const { challenge, related } = Astro.props;

const eventLd = buildEventSchema(challenge);

const statusRaw = challenge.status.toLowerCase();
const statusLabel = challenge.status.replace(/^\w/, (c: string) => c.toUpperCase());
const statusMark = statusRaw === 'active' || statusRaw === 'ongoing' ? '● '
  : statusRaw === 'upcoming' ? '◇ '
  : statusRaw === 'closed' ? '○ '
  : '';

const fmtDate = (d?: string) => {
  if (!d) return '';
  try {
    const date = new Date(d);
    if (isNaN(date.getTime())) return d;
    return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch { return d; }
};
const dateValue = challenge.dateStart && challenge.dateEnd
  ? `${fmtDate(challenge.dateStart)} – ${fmtDate(challenge.dateEnd)}`
  : challenge.dateStart
    ? `From ${fmtDate(challenge.dateStart)}`
    : '';

const locLc = (challenge.location || '').toLowerCase();
const format = !challenge.location ? ''
  : locLc.includes('online') || locLc.includes('virtual') ? 'Online'
  : locLc.includes('hybrid') ? 'Hybrid'
  : 'In-person';
const formatValue = format ? (format === 'In-person' ? `In-person · ${challenge.location}` : format) : '';

// Hero stats — 3 scannable facts max, in priority order
const stats = [
  { value: `${statusMark}${statusLabel}`, label: 'Status' },
  ...(dateValue ? [{ value: dateValue, label: 'Dates' }] : []),
  ...(challenge.prizes ? [{ value: challenge.prizes, label: 'Prize Pool' }] : []),
];

// Key metrics card — structured scannable details
const keyMetrics = [
  ...(formatValue ? [{ metric: 'Format', value: formatValue }] : []),
  ...(challenge.organizer ? [{ metric: 'Organizer', value: challenge.organizer }] : []),
  ...(challenge.teamSize ? [{ metric: 'Team Size', value: challenge.teamSize }] : []),
  ...(challenge.eligibility ? [{ metric: 'Eligibility', value: challenge.eligibility }] : []),
  ...(challenge.registrationDeadline ? [{ metric: 'Register By', value: fmtDate(challenge.registrationDeadline) }] : []),
  ...(challenge.problemDomains?.length ? [{ metric: 'Problem Domains', value: challenge.problemDomains.join(', ') }] : []),
];

const meta = [challenge.organizer, `${statusMark}${statusLabel}`, fmtDate(challenge.dateStart)].filter(Boolean).join(' · ');
---
<BaseLayout unverified={!isPublished(challenge)} title={challenge.name} description={challenge.description} jsonLd={eventLd} ogImage={`/og-images/challenges/${challenge.slug}.png`}>
  <DetailPage
    client:load
    type="Challenge"
    name={challenge.name}
    meta={meta}
    description={challenge.description}
    tags={challenge.tags}
    stats={stats}
    websiteUrl={challenge.website}
    collection="challenges"
    news={challenge.news || []}
    related={related}
    sources={challenge.sources}
    keyMetrics={keyMetrics}
    overviewLinks={[
      { label: 'Browse all challenges', href: '/challenges/' },
    ]}
  />
</BaseLayout>
