---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist in the Kvantiq Directory.">
  <div class="mx-auto max-w-xl py-20 text-center">
    <p class="font-mono text-5xl font-semibold text-text-muted">404</p>
    <h1 class="h-xl mt-4 text-text-primary">Page not found</h1>
    <p class="body-default mt-2 text-text-secondary">The page you're looking for doesn't exist or has been moved.</p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="btn-quantum rounded-md bg-accent px-4 py-2 body-sm font-medium text-void">Back to directory</a>
      <a href="/companies/" class="rounded-md border border-border px-4 py-2 body-sm font-medium text-text-secondary hover:text-text-primary">Browse companies</a>
    </div>
  </div>
</BaseLayout>
