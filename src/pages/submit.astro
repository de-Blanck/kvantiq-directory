---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Submit a Listing" description="Submit a quantum computing company, benchmark, use case, or resource to the Kvantiq Directory.">
  <article class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold">Submit a Listing</h1>

    <div class="summary mt-4" role="doc-abstract">
      <p class="text-text-secondary">
        Help us grow the European quantum computing directory. Submit a company, benchmark,
        use case, challenge, or resource for review.
      </p>
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">What we accept</h2>
      <ul class="mt-2 space-y-1 text-text-secondary">
        <li><strong>Companies:</strong> European quantum computing companies (hardware, software, cloud, consulting, research)</li>
        <li><strong>Benchmarks:</strong> Published, reproducible quantum computing benchmarks</li>
        <li><strong>Use cases:</strong> Real-world hybrid quantum-classical applications with documented results</li>
        <li><strong>Challenges:</strong> Quantum computing hackathons, competitions, and open challenges</li>
        <li><strong>Resources:</strong> Frameworks, courses, funding programs, and tools</li>
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">Submit your entry</h2>
      <p class="mt-2 text-text-secondary">
        Use the form below to submit a listing. We review all submissions manually for accuracy
        and alignment with our <a href="/about/" class="text-info hover:underline">ethics policy</a>.
      </p>

      <!-- Tally.so form placeholder -->
      <div class="mt-4 rounded-lg border-2 border-dashed border-border p-8 text-center">
        <p class="text-text-muted">Submission form coming soon.</p>
        <p class="mt-2 text-sm text-text-muted">
          In the meantime, email your submission details to
          <a href="mailto:submit@kvantiq.studio" class="text-info hover:underline">submit@kvantiq.studio</a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
