---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailPage from '../../components/DetailPage.tsx';
import { findRelated, type RelatedItem } from '../../lib/related';
import { buildDatasetSchema } from '../../lib/jsonld/dataset.ts';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  const benchmarks = await getCollection('benchmarks');
  const useCases = await getCollection('use-cases');
  const challenges = await getCollection('challenges');
  const resources = await getCollection('resources');

  const allItems: RelatedItem[] = [
    ...companies.map(c => ({ slug: c.data.slug, name: c.data.name, description: c.data.description, collection: 'companies', tags: c.data.tags, href: `/companies/${c.data.slug}/` })),
    ...benchmarks.map(b => ({ slug: b.data.slug, name: b.data.name, description: b.data.description, collection: 'benchmarks', tags: b.data.tags, href: `/benchmarks/${b.data.slug}/` })),
    ...useCases.map(u => ({ slug: u.data.slug, name: u.data.name, description: u.data.description, collection: 'use-cases', tags: u.data.tags, href: `/use-cases/${u.data.slug}/` })),
    ...challenges.map(ch => ({ slug: ch.data.slug, name: ch.data.name, description: ch.data.description, collection: 'challenges', tags: ch.data.tags, href: `/challenges/${ch.data.slug}/` })),
    ...resources.map(r => ({ slug: r.data.slug, name: r.data.name, description: r.data.description, collection: 'resources', tags: r.data.tags, href: `/resources/` })),
  ];

  return benchmarks.map(b => ({
    params: { slug: b.data.slug },
    props: {
      benchmark: b.data,
      related: findRelated(b.data.slug, b.data.tags, allItems),
    },
  }));
}

const { benchmark, related } = Astro.props;

const datasetLd = buildDatasetSchema(benchmark);

const stats = [
  ...(benchmark.qubits ? [{ value: String(benchmark.qubits), label: 'Qubits' }] : []),
  { value: benchmark.reproducible ? 'Yes' : 'No', label: 'Reproducible' },
  { value: benchmark.category.replace(/^\w/, (c: string) => c.toUpperCase()), label: 'Category' },
];

const meta = [benchmark.algorithm, benchmark.category.replace(/^\w/, (c: string) => c.toUpperCase()), benchmark.qubits ? `${benchmark.qubits} qubits` : '', benchmark.framework].filter(Boolean).join(' · ');
---
<BaseLayout title={benchmark.name} description={benchmark.description} jsonLd={datasetLd} ogImage={`/og-images/benchmarks/${benchmark.slug}.png`}>
  <DetailPage
    client:load
    type="Benchmark"
    name={benchmark.name}
    meta={meta}
    description={benchmark.description}
    tags={benchmark.tags}
    stats={stats}
    collection="benchmarks"
    news={benchmark.news || []}
    related={related}
    sources={benchmark.sources}
    keyMetrics={benchmark.keyMetrics}
    significance={benchmark.significance}
    extraCards={[
      ...(benchmark.hardware ? [{ id: 'hardware', label: 'Hardware', content: benchmark.hardware }] : []),
      ...(benchmark.framework ? [{ id: 'framework', label: 'Framework', content: benchmark.framework }] : []),
    ]}
    overviewLinks={[
      { label: 'Browse all benchmarks', href: '/benchmarks/' },
    ]}
  />
</BaseLayout>
