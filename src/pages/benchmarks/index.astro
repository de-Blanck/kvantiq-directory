---
import { getCollection } from 'astro:content';
import { publishedOnly } from '../../lib/source-bar';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingView from '../../components/ListingView.tsx';

const allBenchmarks = publishedOnly(await getCollection('benchmarks'));
const sorted = allBenchmarks.sort((a, b) => a.data.name.localeCompare(b.data.name));

const tableData = sorted.map(b => ({
  href: `/benchmarks/${b.data.slug}/`,
  name: b.data.name,
  algorithm: b.data.algorithm,
  category: b.data.category,
  qubits: b.data.qubits ? String(b.data.qubits) : '',
  framework: b.data.framework || '',
}));

const tableColumns = [
  { key: 'name', label: 'Benchmark', isLink: true, sortable: true },
  { key: 'algorithm', label: 'Algorithm', sortable: true },
  { key: 'category', label: 'Category', filterable: true, sortable: true },
  { key: 'qubits', label: 'Qubits', sortable: true },
];

const cardItems = sorted.map(b => ({
  href: `/benchmarks/${b.data.slug}/`,
  name: b.data.name,
  description: b.data.description,
  tags: b.data.tags,
  meta: `${b.data.algorithm} \u00b7 ${b.data.category}`,
  badge: b.data.reproducible ? 'Reproducible' : undefined,
  badgeColor: 'text-accent bg-accent-glow',
  // Group-by fields — mirror of tableData keys so CardGrid can group.
  algorithm: b.data.algorithm,
  category: b.data.category,
  framework: b.data.framework || '',
}));

const groupByOptions = [
  { key: 'category', label: 'Category' },
  { key: 'algorithm', label: 'Algorithm' },
  { key: 'framework', label: 'Framework' },
];

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Quantum Computing Benchmarks",
  "numberOfItems": allBenchmarks.length,
  "itemListElement": sorted.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.data.name,
    "url": `/benchmarks/${b.data.slug}/`,
  })),
};
---
<BaseLayout
  title="Quantum Computing Benchmarks"
  description={`Browse ${allBenchmarks.length} reproducible quantum computing benchmarks across optimization, chemistry, machine learning, and more.`}
  jsonLd={itemListLd}
>
  <article>
    <h1 class="h-xl">Quantum Computing Benchmarks</h1>
    <div class="summary" role={"doc-abstract" as astroHTML.JSX.AriaRole}>
      <p class="mt-4 body-lg text-text-secondary">
        {allBenchmarks.length} reproducible quantum computing benchmarks for hybrid quantum-classical algorithms.
      </p>
    </div>

    <ListingView
      client:load
      tableData={tableData}
      tableColumns={tableColumns}
      cardItems={cardItems}
      searchPlaceholder="Search benchmarks..."
      groupByOptions={groupByOptions}
    />
  </article>
</BaseLayout>
