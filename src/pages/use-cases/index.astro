---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingView from '../../components/ListingView.tsx';

const allUseCases = await getCollection('use-cases');
const sorted = allUseCases.sort((a, b) => a.data.name.localeCompare(b.data.name));

const tableData = sorted.map(u => ({
  href: `/use-cases/${u.data.slug}/`,
  name: u.data.name,
  industry: u.data.industry,
  category: u.data.category,
}));

const tableColumns = [
  { key: 'name', label: 'Use Case', isLink: true, sortable: true },
  { key: 'industry', label: 'Industry', filterable: true, sortable: true },
  { key: 'category', label: 'Category', filterable: true, sortable: true },
];

const cardItems = sorted.map(u => ({
  href: `/use-cases/${u.data.slug}/`,
  name: u.data.name,
  description: u.data.description,
  tags: u.data.tags,
  meta: `${u.data.industry} \u00b7 ${u.data.category}`,
  // Group-by fields — mirror of tableData keys so CardGrid can group.
  industry: u.data.industry,
  category: u.data.category,
}));

const groupByOptions = [
  { key: 'industry', label: 'Industry' },
  { key: 'category', label: 'Category' },
];

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Quantum Computing Use Cases",
  "numberOfItems": allUseCases.length,
  "itemListElement": sorted.map((u, i) => ({
    "@type": "ListItem", "position": i + 1, "name": u.data.name, "url": `/use-cases/${u.data.slug}/`,
  })),
};
---
<BaseLayout
  title="Quantum Computing Use Cases"
  description={`Browse ${allUseCases.length} real-world hybrid quantum-classical use cases across industries.`}
  jsonLd={itemListLd}
>
  <article>
    <h1 class="h-xl">Quantum Computing Use Cases</h1>
    <div class="summary" role="doc-abstract">
      <p class="mt-4 body-lg text-text-secondary">{allUseCases.length} real-world use cases for hybrid quantum-classical computing.</p>
    </div>

    <ListingView
      client:load
      tableData={tableData}
      tableColumns={tableColumns}
      cardItems={cardItems}
      searchPlaceholder="Search use cases..."
      groupByOptions={groupByOptions}
    />
  </article>
</BaseLayout>
