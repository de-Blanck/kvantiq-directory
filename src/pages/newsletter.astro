---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---
<BaseLayout title="Newsletter" description="Subscribe to the Kvantiq Directory newsletter for updates on European quantum computing.">
  <article class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold">Kvantiq Newsletter</h1>

    <div class="summary mt-4" role="doc-abstract">
      <p class="text-text-secondary">
        Stay informed about the European quantum computing ecosystem. We send occasional updates
        when new companies, benchmarks, and resources are added to the directory.
      </p>
    </div>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">What you'll get</h2>
      <ul class="mt-2 space-y-1 text-text-secondary">
        <li>New company and resource listings</li>
        <li>Notable benchmark results and use case updates</li>
        <li>Upcoming quantum computing challenges and events</li>
        <li>European quantum ecosystem news and funding updates</li>
      </ul>
    </section>

    <section class="mt-8">
      <NewsletterSignup />
    </section>
  </article>
</BaseLayout>
