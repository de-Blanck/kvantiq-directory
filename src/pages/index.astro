---
import { getCollection } from 'astro:content';
import { publishedOnly } from '../lib/source-bar';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import JsonLd from '../components/JsonLd.astro';
import SearchBar from '../components/SearchBar.astro';

const allCompanies = publishedOnly(await getCollection('companies'));
const allBenchmarks = publishedOnly(await getCollection('benchmarks'));
const allUseCases = publishedOnly(await getCollection('use-cases'));
const allChallenges = publishedOnly(await getCollection('challenges'));
const allResources = publishedOnly(await getCollection('resources'));
const featured = allCompanies.filter(c => c.data.featured).sort((a, b) => a.data.name.localeCompare(b.data.name));

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Kvantiq Directory",
  "url": "https://directory.kvantiq.studio",
  "description": "The European directory for quantum computing — companies, benchmarks, use cases, and resources.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://directory.kvantiq.studio/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---
<BaseLayout
  title="European Quantum Computing Directory"
  description="The curated directory of quantum computing companies, benchmarks, use cases, and resources across Europe. Focused on Nordics and DACH."
  jsonLd={websiteLd}
  ogImage="/og-images/companies/pasqal.png"
>
  <!-- Hero -->
  <div class="mb-4 py-8 text-center">
    <div class="mx-auto max-w-7xl">
      <h1 class="h-display text-text-primary">
        European Quantum Computing Directory
      </h1>
      <p class="mx-auto mt-3 max-w-2xl body-lg text-text-secondary">
        The European quantum computing ecosystem — companies, benchmarks, use cases, challenges, and resources across Nordics and DACH.
      </p>
      <div class="mx-auto mt-8 flex max-w-2xl justify-center">
        <SearchBar placeholder="Search the directory…" />
      </div>
    </div>
  </div>

  <!-- How to use this directory -->
  <section class="mt-6 rounded-xl border border-border bg-surface p-6">
    <h2 class="eyebrow-lg text-text-secondary">How to use this directory</h2>
    <div class="mt-5 grid gap-6 sm:grid-cols-3">
      <div class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-glow font-mono text-sm font-semibold text-accent">1</span>
        <div>
          <p class="h-sm text-text-primary">Search or browse</p>
          <p class="mt-1 body-sm text-text-secondary">Type to jump anywhere, or pick a tab.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-glow font-mono text-sm font-semibold text-accent">2</span>
        <div>
          <p class="h-sm text-text-primary">Filter, sort, group</p>
          <p class="mt-1 body-sm text-text-secondary">Sort columns. Filter chips. Group by country, type or category.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-glow font-mono text-sm font-semibold text-accent">3</span>
        <div>
          <p class="h-sm text-text-primary">Verify at source</p>
          <p class="mt-1 body-sm text-text-secondary">Every entry links back to its primary sources.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured companies -->
  {featured.length > 0 && (
    <section class="mt-10">
      <h2 class="eyebrow-lg text-text-secondary">Featured Companies</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map(c => (
          <a href={`/companies/${c.data.slug}/`} class="card-hover block rounded-xl border border-border bg-surface p-5">
            <h3 class="h-md text-text-primary truncate">{c.data.name}</h3>
            <p class="mt-1 eyebrow text-text-muted">{c.data.country} · {c.data.type}</p>
            <p class="mt-3 body-sm text-text-secondary line-clamp-2">{c.data.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {c.data.tags.slice(0, 3).map((tag: string) => (
                <span class="rounded-md border border-border bg-base px-2 py-0.5 font-mono text-xs text-text-muted">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="mt-10">
    <NewsletterSignup />
  </section>
</BaseLayout>
