---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import JsonLd from '../components/JsonLd.astro';
import SearchBar from '../components/SearchBar.astro';

const allCompanies = await getCollection('companies');
const allBenchmarks = await getCollection('benchmarks');
const allUseCases = await getCollection('use-cases');
const allChallenges = await getCollection('challenges');
const allResources = await getCollection('resources');
const featured = allCompanies.filter(c => c.data.featured).sort((a, b) => a.data.name.localeCompare(b.data.name));

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Kvantiq Directory",
  "url": "https://kvantiq.com",
  "description": "The European directory for quantum computing — companies, benchmarks, use cases, and resources.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://kvantiq.com/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---
<BaseLayout
  title="European Quantum Computing Directory"
  description="The curated directory of quantum computing companies, benchmarks, use cases, and resources across Europe. Focused on Nordics and DACH."
  jsonLd={websiteLd}
>
  <!-- Hero -->
  <div class="mb-8 py-12 text-center">
    <div class="mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold tracking-tight text-text sm:text-5xl" style="letter-spacing: -0.5px;">
        European Quantum Computing Directory
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-secondary">
        The European quantum computing ecosystem — companies, benchmarks, use cases, challenges, and resources across Nordics and DACH.
      </p>
      <div class="mx-auto mt-6 max-w-md">
        <SearchBar />
      </div>
    </div>
  </div>

  <!-- How to use this directory -->
  <section class="mt-10 rounded-xl border border-border bg-surface p-6">
    <h2 class="font-mono text-[9px] font-medium uppercase tracking-[0.5px] text-text-muted">How to use this directory</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-3">
      <div class="flex gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-info-surface font-mono text-xs font-semibold text-info">1</span>
        <div>
          <p class="text-sm font-semibold text-text">Browse or search</p>
          <p class="mt-0.5 text-xs text-text-secondary leading-relaxed">Use the navigation tabs to explore companies, benchmarks, use cases, challenges, or resources. Or type in the search bar above to find anything instantly.</p>
        </div>
      </div>
      <div class="flex gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-info-surface font-mono text-xs font-semibold text-info">2</span>
        <div>
          <p class="text-sm font-semibold text-text">Filter and sort</p>
          <p class="mt-0.5 text-xs text-text-secondary leading-relaxed">Each listing page has dropdown filters (country, type, category) and sortable columns. Click any column header to sort. Combine filters to narrow results.</p>
        </div>
      </div>
      <div class="flex gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-info-surface font-mono text-xs font-semibold text-info">3</span>
        <div>
          <p class="text-sm font-semibold text-text">Dive into details</p>
          <p class="mt-0.5 text-xs text-text-secondary leading-relaxed">Click any entry to see its full profile — description, metadata, verified sources, and FAQ. Every entry links back to its original sources so you can verify the data yourself.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured companies -->
  {featured.length > 0 && (
    <section class="mt-10">
      <h2 class="font-mono text-[9px] font-medium uppercase tracking-[0.5px] text-text-muted">Featured Companies</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map(c => (
          <a href={`/companies/${c.data.slug}/`} class="block rounded-xl border border-border bg-surface p-5 transition-all duration-[120ms] hover:border-info-border hover:shadow-[var(--shadow-elevated)]">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="font-semibold text-text">{c.data.name}</h3>
                <p class="mt-0.5 font-mono text-[10px] text-text-muted">{c.data.country} · {c.data.type}</p>
              </div>
              <span class="rounded-md bg-ok-surface border border-ok-border px-2 py-0.5 font-mono text-[10px] font-medium text-ok-text">Featured</span>
            </div>
            <p class="mt-2 text-xs text-text-secondary leading-relaxed line-clamp-3">{c.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {c.data.tags.slice(0, 4).map((tag: string) => (
                <span class="rounded-md border border-border bg-surface-alt px-1.5 py-0.5 font-mono text-[10px] text-text-muted">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="mt-10">
    <NewsletterSignup />
  </section>
</BaseLayout>
