---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCard from '../components/ListingCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import JsonLd from '../components/JsonLd.astro';
import SearchBar from '../components/SearchBar.astro';

const allCompanies = await getCollection('companies');
const allBenchmarks = await getCollection('benchmarks');
const allUseCases = await getCollection('use-cases');
const allChallenges = await getCollection('challenges');
const allResources = await getCollection('resources');
const featured = allCompanies.filter(c => c.data.featured).sort((a, b) => a.data.name.localeCompare(b.data.name));

const categories = [
  { href: '/companies/', label: 'Companies', description: 'Quantum computing companies across Europe' },
  { href: '/benchmarks/', label: 'Benchmarks', description: 'Reproducible quantum computing benchmarks' },
  { href: '/use-cases/', label: 'Use Cases', description: 'Real-world hybrid quantum-classical applications' },
  { href: '/challenges/', label: 'Challenges', description: 'Hackathons, competitions, and open challenges' },
  { href: '/resources/', label: 'Resources', description: 'Frameworks, courses, funding, and tools' },
];

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Kvantiq Directory",
  "url": "https://kvantiq.com",
  "description": "The European directory for quantum computing — companies, benchmarks, use cases, and resources.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://kvantiq.com/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---
<BaseLayout
  title="European Quantum Computing Directory"
  description="The curated directory of quantum computing companies, benchmarks, use cases, and resources across Europe. Focused on Nordics and DACH."
  jsonLd={websiteLd}
>
  <!-- Hero - Marketing dark theme with full bleed -->
  <div class="-mx-4 -mt-8 mb-12 bg-void px-4 py-16 text-center">
    <div class="mx-auto max-w-7xl">
      <div class="mb-6 flex justify-center">
        <img src="/kvantiq-logo-white.png" alt="Kvantiq Studio" class="h-12" />
      </div>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl bg-gradient-to-r from-phosphor to-cyan bg-clip-text text-transparent">
        Kvantiq Directory
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        The European quantum computing ecosystem — companies, benchmarks, use cases, challenges, and resources across Nordics and DACH.
      </p>
      <div class="mx-auto mt-6 max-w-md">
        <SearchBar />
      </div>
    </div>
  </div>

  <!-- Stats bar -->
  <section class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    <div class="rounded-lg border border-border bg-surface p-4 text-center">
      <p class="font-mono text-2xl font-semibold text-text">{allCompanies.length}</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-wide text-text-muted">Companies</p>
    </div>
    <div class="rounded-lg border border-border bg-surface p-4 text-center">
      <p class="font-mono text-2xl font-semibold text-text">{allBenchmarks.length}</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-wide text-text-muted">Benchmarks</p>
    </div>
    <div class="rounded-lg border border-border bg-surface p-4 text-center">
      <p class="font-mono text-2xl font-semibold text-text">{allUseCases.length}</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-wide text-text-muted">Use Cases</p>
    </div>
    <div class="rounded-lg border border-border bg-surface p-4 text-center">
      <p class="font-mono text-2xl font-semibold text-text">{allChallenges.length}</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-wide text-text-muted">Challenges</p>
    </div>
    <div class="rounded-lg border border-border bg-surface p-4 text-center">
      <p class="font-mono text-2xl font-semibold text-text">{allResources.length}</p>
      <p class="mt-1 font-mono text-xs uppercase tracking-wide text-text-muted">Resources</p>
    </div>
  </section>

  <!-- Featured companies -->
  {featured.length > 0 && (
    <section class="mt-8">
      <h2 class="text-2xl font-bold">Featured Companies</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map(c => (
          <ListingCard
            title={c.data.name}
            href={`/companies/${c.data.slug}/`}
            description={c.data.description}
            tags={c.data.tags}
            meta={`${c.data.country} · ${c.data.type}`}
            featured={true}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Category cards -->
  <section class="mt-12">
    <h2 class="text-2xl font-bold">Browse the Directory</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map(cat => (
        <a href={cat.href} class="block rounded-lg border border-border p-5 transition hover:shadow-md">
          <h3 class="font-semibold text-info">{cat.label}</h3>
          <p class="mt-1 text-sm text-text-secondary">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="mt-12">
    <NewsletterSignup />
  </section>
</BaseLayout>
