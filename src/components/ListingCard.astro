---
import TagList from './TagList.astro';

interface Props {
  title: string;
  href: string;
  description: string;
  tags: string[];
  meta?: string;
  featured?: boolean;
}
const { title, href, description, tags, meta, featured } = Astro.props;
---
<a href={href} class={`block rounded-xl border p-5 transition-all duration-[120ms] hover:border-info/20 hover:shadow-elevated ${featured ? 'border-info/20 bg-info/15' : 'border-border bg-surface'}`}>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-text-primary">{title}</h3>
    {featured && <span class="shrink-0 rounded-md border border-accent/20 bg-accent-glow px-2 py-0.5 font-mono text-[10px] font-medium text-accent">Featured</span>}
  </div>
  {meta && <p class="mt-0.5 font-mono text-[10px] text-text-muted">{meta}</p>}
  <p class="mt-2 text-xs text-text-secondary leading-relaxed line-clamp-2">{description}</p>
  <div class="mt-3">
    <TagList tags={tags} />
  </div>
</a>
