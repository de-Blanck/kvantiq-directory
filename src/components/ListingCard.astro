---
import TagList from './TagList.astro';

interface Props {
  title: string;
  href: string;
  description: string;
  tags: string[];
  meta?: string;
  featured?: boolean;
}
const { title, href, description, tags, meta, featured } = Astro.props;
---
<a href={href} class={`block rounded-lg border p-5 transition hover:shadow-md ${featured ? 'border-info/30 bg-info/5' : 'border-border'}`}>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-text">{title}</h3>
    {featured && <span class="shrink-0 rounded-full bg-info/10 px-2 py-0.5 text-xs font-medium text-info">Featured</span>}
  </div>
  {meta && <p class="mt-1 text-sm text-text-muted">{meta}</p>}
  <p class="mt-2 text-sm text-text-secondary line-clamp-2">{description}</p>
  <div class="mt-3">
    <TagList tags={tags} />
  </div>
</a>
