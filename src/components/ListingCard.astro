---
import TagList from './TagList.astro';

interface Props {
  title: string;
  href: string;
  description: string;
  tags: string[];
  meta?: string;
  featured?: boolean;
}
const { title, href, description, tags, meta, featured } = Astro.props;
---
<a href={href} class={`card-hover block rounded-xl border p-5 ${featured ? 'border-accent/30 bg-accent-glow' : 'border-border bg-surface'}`}>
  <div class="flex items-start justify-between gap-2">
    <h3 class="h-md text-text-primary">{title}</h3>
    {featured && <span class="eyebrow shrink-0 rounded-md border border-accent/20 bg-accent-glow px-2 py-0.5 text-accent">Featured</span>}
  </div>
  {meta && <p class="eyebrow mt-1 text-text-muted">{meta}</p>}
  <p class="body-sm mt-2 text-text-secondary line-clamp-2">{description}</p>
  <div class="mt-3">
    <TagList tags={tags} />
  </div>
</a>
