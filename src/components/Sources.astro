---
interface Source {
  type: 'doi' | 'arxiv' | 'url' | 'website' | 'press-release';
  url: string;
  title?: string;
  authors?: string;
  datePublished?: string;
  dateAccessed?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

function formatSource(s: Source): string {
  const parts: string[] = [];
  if (s.authors) parts.push(s.authors);
  if (s.title) parts.push(`"${s.title}"`);
  if (s.datePublished) parts.push(s.datePublished);
  if (s.dateAccessed) parts.push(`accessed ${s.dateAccessed}`);
  return parts.join(', ');
}

function sourceLabel(s: Source): string {
  if (s.type === 'doi') return 'DOI';
  if (s.type === 'arxiv') return 'arXiv';
  if (s.type === 'press-release') return 'Press Release';
  try { return new URL(s.url).hostname.replace('www.', ''); } catch { return 'Link'; }
}
---
<section id="sources" class="mt-10 border-t border-border pt-6">
  <h2 class="text-lg font-semibold">Sources</h2>
  <ol class="mt-3 list-decimal space-y-2 pl-6 text-sm text-text-secondary">
    {sources.map((s, i) => (
      <li id={`ref-${i + 1}`}>
        <cite class="not-italic">
          {formatSource(s)}
          {formatSource(s) && ' — '}
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-info hover:underline break-all"
          >
            {sourceLabel(s)}
          </a>
        </cite>
      </li>
    ))}
  </ol>
</section>
