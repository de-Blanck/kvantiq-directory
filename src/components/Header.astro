---
const navItems = [
  { href: '/companies/', label: 'Companies' },
  { href: '/benchmarks/', label: 'Benchmarks' },
  { href: '/use-cases/', label: 'Use Cases' },
  { href: '/challenges/', label: 'Challenges' },
  { href: '/resources/', label: 'Resources' },
  { href: '/about/', label: 'About' },
  { href: '/transparency/', label: 'Transparency' },
];
const currentPath = Astro.url.pathname;
---
<header class="border-b border-border bg-surface" data-pagefind-ignore>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-6">
    <a href="/" class="nav-logo flex items-center gap-3" aria-label="Kvantiq Studio Directory home">
      <svg
        width="21"
        height="33"
        viewBox="0 0 16 26"
        fill="none"
        aria-hidden="true"
        class="nav-logo__mark shrink-0"
      >
        <path class="nav-logo__stroke" d="M0 3.416C4.923 13.877 9.846 13.877 14.77 3.416" stroke="var(--color-brand)" stroke-width="1.846" stroke-linecap="round" stroke-linejoin="round" />
        <path class="nav-logo__stroke" d="M0 21.877C4.923 11.416 9.846 11.416 14.77 21.877" stroke="var(--color-brand)" stroke-width="1.846" stroke-linecap="round" stroke-linejoin="round" />
        <path class="nav-logo__stroke" d="M1.847 0.646C5.539 9.877 9.231 9.877 12.924 0.646" stroke="var(--color-brand)" stroke-width="1.292" stroke-linecap="round" stroke-linejoin="round" />
        <path class="nav-logo__stroke" d="M1.847 24.646C5.539 15.416 9.231 15.416 12.924 24.646" stroke="var(--color-brand)" stroke-width="1.292" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="nav-logo__wordmark flex flex-col items-end leading-none font-mono uppercase" aria-hidden="true">
        <span class="nav-logo__kvantiq font-semibold text-text-primary" style="font-size: 20px; letter-spacing: 0.12em;">Kvantiq</span>
        <span class="nav-logo__studio font-normal" style="font-size: 13px; letter-spacing: 0.16em;">Studio</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden gap-6 md:flex">
      {navItems.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`text-sm font-medium transition-colors duration-[120ms] ${currentPath.startsWith(href) ? 'nav-active text-text-primary' : 'text-text-muted hover:text-text-primary'}`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop Submit Button -->
    <a href="/submit/" class="btn-quantum hidden md:block rounded-md bg-info px-3 py-1.5 text-sm font-medium text-white">
      Submit Listing
    </a>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-button"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="block h-0.5 w-6 bg-text-muted"></span>
      <span class="block h-0.5 w-6 bg-text-muted"></span>
      <span class="block h-0.5 w-6 bg-text-muted"></span>
    </button>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-void/70 z-40 hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="fixed top-0 right-0 bottom-0 w-64 bg-surface shadow-xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col h-full">
      <!-- Close Button -->
      <div class="flex justify-end p-4 border-b border-border">
        <button
          id="mobile-menu-close"
          class="p-2 text-text-secondary hover:text-text-primary"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Nav Links -->
      <ul class="flex flex-col py-4">
        {navItems.map(({ href, label }) => (
          <li class="border-b border-border">
            <a
              href={href}
              class={`block px-6 py-3 text-base font-medium ${currentPath.startsWith(href) ? 'text-accent bg-accent-glow' : 'text-text-secondary hover:text-accent hover:bg-elevated'}`}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Submit Button -->
      <div class="mt-auto p-4">
        <a href="/submit/" class="btn-quantum block text-center rounded-md bg-info px-4 py-3 text-base font-medium text-white">
          Submit Listing
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');

    function openMenu() {
      menu.classList.remove('translate-x-full');
      overlay.classList.remove('hidden');
      menuButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menu.classList.add('translate-x-full');
      overlay.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Open menu
    menuButton.addEventListener('click', openMenu);

    // Close menu
    closeButton.addEventListener('click', closeMenu);

    // Close when clicking overlay
    overlay.addEventListener('click', closeMenu);

    // Close when clicking a nav link
    menu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !menu.classList.contains('translate-x-full')) {
        closeMenu();
      }
    });
  })();
</script>
