---
import { getCollection } from 'astro:content';
import SearchExpand, { type SearchItem } from './SearchExpand';
import { publishedOnly } from '../lib/source-bar';

interface Props {
  placeholder?: string;
}
const { placeholder = 'Search the directory…' } = Astro.props;

// Build a lean cross-collection index at build time.
// Used only by this component's inline results dropdown. No modal, no global shortcut.
const [companies, benchmarks, useCases, challenges, resources] = await Promise.all([
  getCollection('companies').then(publishedOnly),
  getCollection('benchmarks').then(publishedOnly),
  getCollection('use-cases').then(publishedOnly),
  getCollection('challenges').then(publishedOnly),
  getCollection('resources').then(publishedOnly),
]);

const items: SearchItem[] = [
  ...companies.map(c => ({ id: `companies:${c.data.slug}`, name: c.data.name, description: c.data.description, collection: 'companies' as const, href: `/companies/${c.data.slug}/` })),
  ...benchmarks.map(b => ({ id: `benchmarks:${b.data.slug}`, name: b.data.name, description: b.data.description, collection: 'benchmarks' as const, href: `/benchmarks/${b.data.slug}/` })),
  ...useCases.map(u => ({ id: `use-cases:${u.data.slug}`, name: u.data.name, description: u.data.description, collection: 'use-cases' as const, href: `/use-cases/${u.data.slug}/` })),
  ...challenges.map(ch => ({ id: `challenges:${ch.data.slug}`, name: ch.data.name, description: ch.data.description, collection: 'challenges' as const, href: `/challenges/${ch.data.slug}/` })),
  ...resources.map(r => ({ id: `resources:${r.data.slug}`, name: r.data.name, description: r.data.description, collection: 'resources' as const, href: r.data.website, external: true })),
].sort((a, b) => a.name.localeCompare(b.name));
---
<SearchExpand client:load items={items} placeholder={placeholder} />
