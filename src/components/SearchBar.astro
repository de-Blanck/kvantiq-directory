---
// Resting command-bar trigger. Large, commanding input-shaped button.
// The actual palette is mounted once globally in BaseLayout via CommandBar.
// Clicking or focusing this trigger dispatches the global open event.
interface Props {
  placeholder?: string;
  size?: 'default' | 'hero';
}
const { placeholder = 'Search companies, benchmarks, use cases, challenges, resources', size = 'hero' } = Astro.props;
const padY = size === 'hero' ? 'py-4' : 'py-3';
const textCls = size === 'hero' ? 'body-lg' : 'body-default';
---
<div id="search" class="w-full">
  <button
    type="button"
    id="cmdbar-trigger"
    class={`group flex w-full items-center gap-3 rounded-lg border border-border bg-surface px-4 ${padY} text-left shadow-subtle transition-colors hover:border-accent/35 hover:bg-elevated focus:outline-none focus-visible:border-accent`}
    aria-label="Open command palette"
    aria-haspopup="dialog"
  >
    <svg
      class="h-5 w-5 flex-shrink-0 text-text-muted group-hover:text-accent"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="9" cy="9" r="6"></circle>
      <path d="m17 17-3.5-3.5" stroke-linecap="round"></path>
    </svg>
    <span class={`${textCls} flex-1 text-text-muted`}>{placeholder}</span>
    <span class="hidden items-center gap-1 sm:flex">
      <kbd class="rounded border border-border bg-base px-1.5 py-0.5 font-mono text-xs text-text-muted">⌘K</kbd>
    </span>
  </button>
</div>

<script>
  const trigger = document.getElementById('cmdbar-trigger');
  trigger?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('kvantiq:cmdbar-open'));
  });
</script>
