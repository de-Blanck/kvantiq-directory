{
  "name": "kvantiq-directory",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/sync-entry-first-seen.ts && node scripts/check-transparency-data.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "audit:content": "npx tsx scripts/content-audit.ts",
    "audit:sources": "node scripts/audit-sources.mjs",
    "test": "tsx scripts/run-tests.ts",
    "type-check": "astro check",
    "check:data": "node scripts/check-transparency-data.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.1",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.2",
    "resend": "^6.9.4",
    "satori": "^0.26.0",
    "tailwindcss": "^4.2.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.58.2",
    "@types/react-grid-layout": "^1.3.6",
    "@types/uuid": "^10.0.0",
    "pagefind": "^1.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
