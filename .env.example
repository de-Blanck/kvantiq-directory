# Citation-probe panel — required for `npx tsx scripts/citation-probe.ts`
#
# All four are required for a complete weekly run (30 prompts × 4 models = 120 calls).
# Mirror these as GitHub repo secrets for the weekly workflow at
# .github/workflows/citation-probe.yml.

ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com/
OPENAI_API_KEY=sk-...               # https://platform.openai.com/api-keys
PERPLEXITY_API_KEY=pplx-...         # https://www.perplexity.ai/settings/api
GOOGLE_API_KEY=...                  # https://aistudio.google.com/app/apikey
