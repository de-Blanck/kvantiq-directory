# The Vercel CLI does NOT read .gitignore. Without this file it uploads the whole
# working directory — which is how .env (a live OAuth token), the local SQLite db
# and assorted scratch dirs reached a production deployment on 2026-09-04.
#
# Anything the build genuinely needs must stay OUT of this list: package.json,
# astro.config.mjs, tsconfig.json, src/, public/, scripts/, data/sources.json,
# data/discovery-queue.json, data/entry-first-seen.json, and
# data/generated/sweep-runs.json.

# Secrets — never
.env
.env.*

# VCS + CI metadata
.git
.gitattributes

# Build output and caches (Vercel builds from source)
.astro
dist
node_modules
*.log

# Local tooling / AI-assistant scratch
.claude
.vscode
.local-design-audit
.ui-swarm
.visual-signoff
.worktrees

# Local database — `npm run prebuild` rebuilds it from src/content on every build
data/kvantiq.db
data/pending-*.json
data/weekly-agent-prompt.md

# Transparency data is regenerated by prebuild, EXCEPT the sweep history, which
# is appended by scripts/ai-sweep.mjs and cannot be derived from anything else.
data/generated/*
!data/generated/sweep-runs.json

# OS noise
.DS_Store
